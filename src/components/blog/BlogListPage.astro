---
/** Página de listagem do blog — usada por /blog/ e /blog/pagina/<n>/ */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../Eyebrow.astro';
import PostGrid from './PostGrid.astro';
import type { Post } from '../../lib/blog';
import { bgImage } from '../../lib/images';

interface Props {
  posts: Post[];
  current: number;
  total: number;
}

const { posts, current, total } = Astro.props;
const heroBg = await bgImage('hero-transplantes-bg.png');
---

<BaseLayout
  title={current > 1 ? `Blog – Página ${current}` : 'Blog'}
  description="Artigos, notícias e informações sobre transplantes, cirurgia digestiva e saúde abdominal, com base científica e linguagem acessível."
>
  <section class="section blog-hero" style={`background-image:url('${heroBg}')`}>
    <div class="container">
      <div class="col w-100 col--middle">
        <div class="col-inner">
          <Eyebrow text="Blog" layout="center" pad={50} color="#fff" />
          <h1 class="blog-hero__title">Conteúdo médico de quem vive a especialidade</h1>
          <div class="blog-hero__lead">
            <p>
              Artigos, notícias e informações sobre transplantes, cirurgia digestiva e saúde abdominal, com base
              científica e linguagem acessível.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section blog-list">
    <div class="container">
      <div class="col w-100">
        <div class="col-inner">
          <PostGrid posts={posts} page={{ current, total }} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero {
    background-color: #2b6767;
    background-size: cover;
    background-position: center;
  }

  .blog-hero .col-inner {
    padding: 25px;
  }

  .blog-hero__title {
    margin-bottom: 20px;
    font-family: var(--f-title);
    font-size: 35px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    color: #fff;
  }

  .blog-hero__lead {
    margin: -5px 0 -15px;
    padding: 0 150px;
    font-family: var(--f-text);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.5;
    text-align: center;
    color: #fff;
  }

  .blog-list {
    padding: 25px 0;
  }

  @media (max-width: 767px) {
    .blog-hero__title {
      font-size: 30px;
    }

    .blog-hero__lead {
      padding: 0;
      text-align: left;
    }
  }
</style>
