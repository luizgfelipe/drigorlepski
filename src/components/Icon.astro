---
/**
 * Ícone SVG inline (Font Awesome 5, mesmos ícones do site atual).
 * Uso: <Icon name="arrow-right" size={17} />
 */
const icons = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props {
  name: string;
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, size = '1em', class: className = '', label } = Astro.props;
const raw = icons[`../icons/${name}.svg`];
if (!raw) throw new Error(`Ícone não encontrado: ${name}`);

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 512 512';
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  class={`icon ${className}`}
  style={`height:${dim};width:auto;`}
  fill="currentColor"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={inner}
/>
