---
/**
 * Vídeo do YouTube (não listado) com "fachada": mostra só a capa e carrega o player
 * (youtube-nocookie) quando a pessoa clica. Evita baixar ~500 KB de JS do YouTube à toa.
 * Formato vertical 9:16, igual ao vídeo atual (310×551, cantos arredondados).
 */
import Img from './Img.astro';
import Icon from './Icon.astro';
import { asset } from '../lib/images';

interface Props {
  /** ID do vídeo no YouTube. Vazio = só a capa, sem player. */
  id: string;
  /** capa usada enquanto não houver ID do YouTube (nome do arquivo em src/assets/images) */
  poster: string;
  title: string;
}

const { id, poster, title } = Astro.props;
// Com o ID preenchido, a capa vem do próprio YouTube. A miniatura "hqdefault" de um vídeo vertical
// tem faixas pretas nas laterais; com object-fit: cover no quadro 9:16 sobra só o vídeo.
const cover = id ? `https://i.ytimg.com/vi/${encodeURIComponent(id)}/hqdefault.jpg` : '';
---

<div class="yt" data-yt-id={id || undefined} data-yt-title={title}>
  {
    cover ? (
      <img class="yt__poster" src={cover} alt="" loading="lazy" width="310" height="551" />
    ) : (
      <Img class="yt__poster" src={asset(poster)} alt="" width={310} height={551} densities={[1, 2]} />
    )
  }
  <button type="button" class="yt__play" aria-label={`Assistir: ${title}`} disabled={!id} data-yt-play>
    <Icon name="play" />
  </button>
</div>

<script>
  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-yt-play]');
    if (!btn) return;
    const box = btn.closest<HTMLElement>('.yt');
    const id = box?.dataset.ytId;
    if (!box || !id) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&playsinline=1&modestbranding=1`;
    iframe.title = box.dataset.ytTitle ?? 'Vídeo';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.className = 'yt__frame';
    box.replaceChildren(iframe);
  });
</script>

<style>
  .yt {
    position: relative;
    width: 310px;
    max-width: 100%;
    aspect-ratio: 310 / 551;
    margin-inline: auto;
    overflow: hidden;
    background-color: #000;
    border-radius: 10px;
  }

  .yt__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: #fff;
    background: rgba(0, 0, 0, 0.15);
    border: 0;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .yt__play :global(.icon) {
    width: 64px !important;
    height: 64px !important;
    padding: 18px 16px 18px 22px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 50%;
    transition: transform 0.3s;
  }

  .yt__play:hover :global(.icon) {
    transform: scale(1.08);
  }

  .yt__play:disabled {
    cursor: default;
  }

  .yt :global(.yt__frame) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
