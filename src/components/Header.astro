---
import Img from './Img.astro';
import NavMenu from './NavMenu.astro';
import { asset } from '../lib/images';
---

<header class="site-header section">
  <div class="container">
    <div class="col w-100">
      <div class="col-inner">
        <div class="row">
          <div class="col site-header__logo">
            <div class="col-inner">
              <a href="/" aria-label="Dr. Igor Lepski — página inicial">
                <Img src={asset('logo.png')} alt="Dr. Igor Lepski" width={204} height={60} densities={[1, 2, 3]} loading="eager" />
              </a>
            </div>
          </div>
          <div class="col site-header__nav col--middle">
            <div class="col-inner">
              <NavMenu id="menu-topo" layout="horizontal" toggleAlign="right" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--navy);
    z-index: 100;
  }

  .site-header__logo {
    width: 20%;
  }

  .site-header__logo img {
    display: block;
    width: 100%;
    max-width: 204px;
    height: auto;
  }

  .site-header__nav {
    width: 80%;
  }

  /* a lista suspensa flutua por cima da página, 10px abaixo do botão, na largura toda da tela
     (o botão fica a 20px da borda direita: 10px da coluna + 10px do container) */
  .site-header :global(.nav) {
    position: relative;
  }

  .site-header :global(.nav__list--dropdown) {
    position: absolute;
    top: calc(100% + 10px);
    right: -20px;
    width: 100vw;
    margin-top: 0 !important;
    z-index: 9997;
  }

  @media (max-width: 767px) {
    .site-header__logo,
    .site-header__nav {
      width: 50% !important;
    }

    .site-header .row {
      flex-wrap: nowrap;
    }
  }
</style>
