---
/**
 * Carrossel de depoimentos (Swiper — a mesma biblioteca usada pelo Elementor).
 * 3 por vez no desktop, 2 no tablet, 1 no celular; autoplay de 5s, loop, pausa no hover.
 */
import Icon from './Icon.astro';
import { REVIEWS } from '../data/reviews';
import { img } from '../config/site';
// CSS do Swiper importado aqui (e não dentro do <script>) para virar estilo da página:
// assim ele continua presente ao voltar para a Home pela navegação sem recarregar.
import 'swiper/css';
import 'swiper/css/pagination';
---

<div class="reviews" data-reviews>
  <div class="swiper reviews__swiper">
    <div class="swiper-wrapper">
      {
        REVIEWS.map((r) => (
          <div class="swiper-slide reviews__slide">
            <div class="reviews__header">
              <img class="reviews__avatar" src={img('review-avatar.png')} alt={r.name} width="36" height="36" loading="lazy" />
              <cite class="reviews__cite">
                <span class="reviews__name">{r.name}</span>
                <span class="reviews__stars" role="img" aria-label={`${r.rating} de 5 estrelas`}>
                  {Array.from({ length: 5 }, (_, i) => (
                    <i class:list={['reviews__star', { 'is-full': i < r.rating }]}>★</i>
                  ))}
                </span>
              </cite>
              <span class="reviews__source" aria-label="Avaliação do Google">
                <Icon name="google" size={17} />
              </span>
            </div>
            <div class="reviews__content">
              <p class="reviews__text">{r.text}</p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="swiper-pagination reviews__pagination"></div>
  </div>
</div>

<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination } from 'swiper/modules';

  function init() {
    document.querySelectorAll<HTMLElement>('[data-reviews]:not([data-ready])').forEach((root) => {
      root.dataset.ready = 'true';
      const el = root.querySelector<HTMLElement>('.swiper');
      if (!el) return;
      new Swiper(el, {
        modules: [Autoplay, Pagination],
        loop: true,
        speed: 500,
        grabCursor: true, // cursor de "mãozinha" para arrastar os depoimentos com o mouse
        spaceBetween: 10,
        slidesPerView: 1,
        breakpoints: {
          768: { slidesPerView: 2 },
          1025: { slidesPerView: 3 },
        },
        autoplay: { delay: 5000, pauseOnMouseEnter: true, disableOnInteraction: true },
        pagination: { el: root.querySelector<HTMLElement>('.swiper-pagination'), clickable: true },
      });
    });
  }

  // roda na primeira carga e a cada troca de página (ClientRouter)
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .reviews {
    padding: 0 28px;
  }

  .reviews__swiper {
    padding-bottom: 40px;
  }

  .reviews__slide {
    display: flex;
    flex-direction: column;
    height: auto;
    background-color: #fff;
    border: 1px solid #e1e8ed;
    border-radius: 5px;
  }

  .reviews__header {
    display: flex;
    align-items: flex-start;
    padding: 15px 15px 6px;
  }

  .reviews__avatar {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    object-fit: cover;
  }

  .reviews__cite {
    display: flex;
    flex-direction: column;
    margin-inline-start: 15px;
    font-style: normal;
  }

  .reviews__name {
    font-family: var(--f-ui);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--blue);
  }

  .reviews__stars {
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0;
    color: #ccd6df;
  }

  .reviews__star {
    font-style: normal;
  }

  .reviews__star.is-full {
    color: #f0ad4e;
  }

  .reviews__source {
    margin-left: auto;
    color: var(--green);
    line-height: 1;
  }

  .reviews__content {
    padding: 6px 15px 15px;
  }

  .reviews__text {
    margin: 0;
    font-family: var(--f-ui);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-2);
  }

  .reviews :global(.swiper-pagination-bullet) {
    cursor: pointer;
    width: 6px;
    height: 6px;
    margin: 0 6px !important;
    background: #000;
  }

  .reviews :global(.swiper-pagination-bullets) {
    bottom: 0;
  }

  @media (max-width: 767px) {
    .reviews {
      padding: 0 9px;
    }
  }
</style>
