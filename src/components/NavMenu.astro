---
/**
 * Menu de navegação.
 *  - layout "horizontal": cabeçalho (submenus em dropdown no hover)
 *  - layout "vertical"  : rodapé (lista vertical)
 * Em telas <= 1024px os dois viram o botão "hambúrguer" com a lista abrindo abaixo (como no site atual).
 */
import Icon from './Icon.astro';
import { NAV } from '../config/site';

interface Props {
  layout?: 'horizontal' | 'vertical';
  /** alinhamento do botão hambúrguer */
  toggleAlign?: 'left' | 'right';
  id: string;
}

const { layout = 'horizontal', toggleAlign = 'right', id } = Astro.props;
const current = Astro.url.pathname;
const isActive = (href?: string) => (href ? (href === '/' ? current === '/' : current.startsWith(href)) : false);
const hasActiveChild = (children?: { href: string }[]) => !!children?.some((c) => isActive(c.href));
---

<nav class:list={['nav', `nav--${layout}`, `nav--toggle-${toggleAlign}`]} aria-label="Menu" data-nav>
  <ul class="nav__list nav__list--main">
    {
      NAV.map((item) => (
        <li class:list={['nav__item', { 'has-children': item.children }]}>
          {item.children ? (
            <button
              type="button"
              class:list={['nav__link', { 'is-active': hasActiveChild(item.children) }]}
              aria-expanded="false"
              data-submenu-toggle
            >
              {item.label}
              <span class="nav__arrow">
                <Icon name="caret-down" />
              </span>
            </button>
          ) : (
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
              {item.label}
            </a>
          )}
          {item.children && (
            <ul class="nav__sub">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} class:list={['nav__sublink', { 'is-active': isActive(child.href) }]}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <button
    type="button"
    class="nav__toggle"
    aria-label="Abrir menu"
    aria-expanded="false"
    aria-controls={`${id}-dropdown`}
    data-nav-toggle
  >
    <span class="nav__toggle-open"><Icon name="bars" /></span>
    <span class="nav__toggle-close"><Icon name="times" /></span>
  </button>

  <ul class="nav__list nav__list--dropdown" id={`${id}-dropdown`}>
    {
      NAV.map((item) => (
        <li class:list={['nav__item', { 'has-children': item.children }]}>
          {item.children ? (
            <button
              type="button"
              class:list={['nav__dlink', { 'is-active': hasActiveChild(item.children) }]}
              aria-expanded="false"
              data-submenu-toggle
            >
              {item.label}
              <span class="nav__arrow">
                <Icon name="caret-down" />
              </span>
            </button>
          ) : (
            <a href={item.href} class:list={['nav__dlink', { 'is-active': isActive(item.href) }]}>
              {item.label}
            </a>
          )}
          {item.children && (
            <ul class="nav__dsub">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} class:list={['nav__dlink nav__dlink--sub', { 'is-active': isActive(child.href) }]}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Um único listener no documento: continua funcionando depois das trocas de página do ClientRouter.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const toggle = target.closest<HTMLButtonElement>('[data-nav-toggle]');
    if (toggle) {
      const nav = toggle.closest('[data-nav]');
      const open = nav?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      return;
    }

    const sub = target.closest<HTMLButtonElement>('[data-submenu-toggle]');
    if (sub) {
      const item = sub.closest('.nav__item');
      const open = item?.classList.toggle('is-open') ?? false;
      sub.setAttribute('aria-expanded', String(open));
      return;
    }

    // clique fora fecha os submenus abertos (cabeçalho e rodapé)
    document.querySelectorAll('.nav__list--main .nav__item.is-open').forEach((el) => {
      if (!el.contains(target)) {
        el.classList.remove('is-open');
        el.querySelector('[data-submenu-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  .nav {
    position: relative;
    width: 100%;
  }

  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    display: flex;
    align-items: center;
    padding: 13px 20px;
    font-family: var(--f-ui);
    font-size: 16px;
    font-weight: 500;
    line-height: 20px;
    text-transform: uppercase;
    color: #fff;
    background: none;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav__arrow {
    display: flex;
    align-items: center;
    padding: 10px 0 10px 10px;
    margin-block: -10px;
    font-size: 16px;
  }

  .nav__arrow :global(.icon) {
    height: 1em !important;
  }

  /* ---------- horizontal (cabeçalho) ---------- */
  .nav--horizontal .nav__list--main {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .nav--horizontal .nav__item {
    position: relative;
  }

  /* hover (cabeçalho e rodapé): linha branca de 3px na base do item, com fade (mesmo efeito do site antigo) */
  .nav__list--main .nav__link {
    position: relative;
  }

  .nav__list--main .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    background-color: #fff;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.58, 0.3, 0.005, 1);
    pointer-events: none;
  }

  .nav__list--main .nav__link:hover::after,
  .nav__list--main .nav__link:focus-visible::after,
  .nav__list--main .nav__link.is-active::after,
  .nav__list--main .nav__item:hover > .nav__link::after,
  .nav__list--main .nav__item.is-open > .nav__link::after {
    opacity: 1;
  }

  .nav--horizontal .nav__sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 2100;
    display: none;
    min-width: 12em;
    margin: 0;
    padding: 0;
    list-style: none;
    background-color: var(--navy);
  }

  .nav--horizontal .nav__item:hover > .nav__sub,
  .nav--horizontal .nav__item:focus-within > .nav__sub,
  .nav--horizontal .nav__item.is-open > .nav__sub {
    display: block;
  }

  .nav__sublink {
    display: block;
    padding: 13px 20px;
    font-family: var(--f-ui);
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
    color: #fff;
    white-space: nowrap;
    transition: background-color 0.3s, color 0.3s;
  }

  .nav__sublink:hover,
  .nav__sublink:focus,
  .nav__sublink.is-active {
    color: var(--navy);
    background-color: #fff;
  }

  /* ---------- vertical (rodapé) ---------- */
  .nav--vertical .nav__list--main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nav--vertical .nav__item {
    position: relative;
  }

  .nav--vertical .nav__link {
    padding: 5px 20px;
  }

  /* o submenu flutua ao lado do item (alinhado pela base), sem alterar a altura do rodapé
     nem a rolagem da página. Em telas mais estreitas ele abre para cima, para não sair da tela. */
  .nav--vertical .nav__sub {
    position: absolute;
    left: 100%;
    bottom: 0;
    z-index: 2100;
    min-width: 12em;
    margin: 0;
    padding: 0;
    list-style: none;
    background-color: var(--navy);
    border-radius: 3px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  .nav--vertical .nav__item:hover > .nav__sub,
  .nav--vertical .nav__item:focus-within > .nav__sub,
  .nav--vertical .nav__item.is-open > .nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s;
  }

  @media (max-width: 1280px) {
    .nav--vertical .nav__sub {
      left: 20px;
      bottom: 100%;
      transform: translateY(6px);
    }
  }

  .nav--vertical .nav__sub li:first-child .nav__sublink {
    border-radius: 3px 3px 0 0;
  }

  .nav--vertical .nav__sub li:last-child .nav__sublink {
    border-radius: 0 0 3px 3px;
  }

  /* ---------- hambúrguer + lista suspensa (<= 1024px) — medidas do site antigo ---------- */
  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 5px;
    font-size: 20px;
    line-height: 1;
    color: var(--navy);
    background-color: #fff;
    border: 0;
    border-radius: 3px;
    cursor: pointer;
  }

  .nav__toggle :global(.icon) {
    height: 1em !important;
    width: 1em !important;
  }

  .nav__toggle-close {
    display: none;
  }

  .nav.is-open .nav__toggle-open {
    display: none;
  }

  .nav.is-open .nav__toggle-close {
    display: flex;
  }

  .nav__toggle-open {
    display: flex;
  }

  /* a lista desce deslizando (altura + escala vertical em 0,3s, como no Elementor) */
  .nav__list--dropdown {
    max-height: 0;
    overflow: hidden auto;
    background-color: var(--navy);
    transform: scaleY(0);
    transform-origin: top;
    visibility: hidden; /* fechado: links fora do alcance do teclado */
    transition:
      max-height 0.3s,
      transform 0.3s,
      visibility 0s linear 0.3s;
  }

  .nav.is-open .nav__list--dropdown {
    max-height: 100vh;
    transform: scaleY(1);
    visibility: visible;
    transition:
      max-height 0.3s,
      transform 0.3s,
      visibility 0s;
  }

  .nav__dlink {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    padding: 10px 20px;
    font-family: var(--f-ui);
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
    text-transform: uppercase;
    color: #fff;
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .nav__dlink--sub {
    text-transform: none;
  }

  /* seta logo depois do texto */
  .nav__dlink .nav__arrow {
    padding: 10px 0 10px 10px;
    margin-block: -10px;
    font-size: inherit;
  }

  /* hover, página atual e item pai aberto: fundo branco e texto azul */
  .nav__dlink:hover,
  .nav__dlink:focus-visible,
  .nav__dlink.is-active,
  .nav__list--dropdown .nav__item.is-open > .nav__dlink {
    color: var(--navy);
    background-color: #fff;
  }

  /* submenu abre deslizando dentro da lista */
  .nav__dsub {
    max-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    list-style: none;
    visibility: hidden;
    transition:
      max-height 0.25s ease,
      visibility 0s linear 0.25s;
  }

  .nav__list--dropdown .nav__item.is-open > .nav__dsub {
    max-height: 400px;
    visibility: visible;
    transition:
      max-height 0.25s ease,
      visibility 0s;
  }

  @media (max-width: 1024px) {
    .nav__list--main {
      display: none !important;
    }

    .nav__toggle {
      display: flex;
    }

    .nav--toggle-right .nav__toggle {
      margin-left: auto;
    }

    .nav--toggle-left .nav__toggle {
      margin-right: auto;
    }

    .nav__list--dropdown {
      margin-top: 10px;
    }
  }

  @media (min-width: 1025px) {
    .nav__list--dropdown {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .nav__dlink {
      font-size: 15px;
    }
  }
</style>
