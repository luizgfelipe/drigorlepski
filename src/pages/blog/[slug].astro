---
/**
 * Páginas estáticas dos artigos — geradas no build a partir do WordPress (ou de posts-seed.json).
 * Posts publicados depois do último build são atendidos pela página coringa /blog/post/ (ver public/.htaccess).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostView from '../../components/blog/PostView.tsx';
import { getAllPostsForBuild, type Post } from '../../lib/wp';

export async function getStaticPaths() {
  const posts = await getAllPostsForBuild();
  return posts.filter((p) => p.slug !== 'post').map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt} image={post.image ?? undefined} type="article">
  <PostView post={post} html={post.content} />
</BaseLayout>
