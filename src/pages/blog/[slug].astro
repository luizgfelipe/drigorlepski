---
/** Página de cada artigo — gerada no build a partir de src/content/blog/<slug>.md */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, type Post } from '../../lib/blog';
import '../../components/blog/post.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post.entry);
---

<BaseLayout title={post.title} description={post.excerpt} image={post.image} type="article">
  <article>
    <section class="section post-hero">
      <div class="container">
        <div class="col w-100">
          <div class="col-inner">
            <div class="post-eyebrow" aria-hidden="true">
              <p class="post-eyebrow__text">Blog</p>
              <span class="post-eyebrow__line"></span>
            </div>
            <h1 class="post-hero__title">{post.title}</h1>
            <div class="post-hero__image">
              <img
                src={post.image}
                alt={post.imageAlt}
                width={post.imageWidth}
                height={post.imageHeight}
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section post-body">
      <div class="container">
        <div class="col w-100">
          <div class="col-inner">
            <div class="post-content">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
