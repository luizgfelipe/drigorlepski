# URL do WordPress headless (só para o blog). Sem barra no final.
# Usada no build (gera as páginas estáticas dos posts) e no navegador (busca posts novos em tempo real).
# Enquanto o WordPress novo não existir, deixe vazio: o site usa os 3 posts de src/data/posts-seed.json.
PUBLIC_WP_URL=https://cms.drigorlepski.com.br
